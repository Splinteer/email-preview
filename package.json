{
  "name": "email-preview",
  "private": true,
  "version": "0.0.0",
  "description": "Real-time B2B email client preview — browser-side sanitizer simulation",
  "license": "MIT",
  "packageManager": "pnpm@9.0.6",
  "scripts": {
    "build": "pnpm -r --filter @supplydatahub/email-preview --filter @supplydatahub/email-preview-angular run build",
    "test": "pnpm --filter @supplydatahub/email-preview test",
    "dev": "pnpm --filter @supplydatahub/email-preview-playground dev",
    "lint": "pnpm -r run lint --if-present",
    "typecheck": "pnpm -r run typecheck --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "tsup": "^8.4.0",
    "vitest": "^3.1.0"
  }
}
